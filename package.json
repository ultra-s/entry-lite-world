{
  "name": "@entrylite/world",
  "version": "1.0.0",
  "description": "Entry-Lite production World for the Vercel Workflow SDK \u2014 plain node-postgres, no drizzle/graphile. Entry-Lite's own durable backend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bootstrap": "./dist/bootstrap.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@workflow/errors": "5.0.5",
    "@workflow/world": "5.0.5",
    "pg": "^8.20.0",
    "ulid": "^3.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0"
  }
}